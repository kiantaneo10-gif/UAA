rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function activeUser() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.isActive == true;
    }

    function admin() {
      return activeUser()
        && get(userPath(request.auth.uid)).data.role == 'admin';
    }

    function validProduct() {
      return request.resource.data.keys().hasAll([
          'sortOrder', 'name', 'price', 'category', 'status',
          'stockStatus', 'image', 'description'
        ])
        && request.resource.data.keys().hasOnly([
          'sortOrder', 'name', 'price', 'category', 'status',
          'stockStatus', 'image', 'description'
        ])
        && request.resource.data.sortOrder is int
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 160
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.category is string
        && request.resource.data.status in ['', 'new', 'popular', 'sale']
        && request.resource.data.stockStatus in ['in_stock', 'out_of_stock']
        && request.resource.data.image is string
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 5000;
    }

    function validTestOrder() {
      return activeUser()
        && request.resource.data.keys().hasAll([
          'orderNumber', 'userId', 'customerName', 'customerEmail', 'items',
          'subtotal', 'discount', 'total', 'coupon', 'paymentMethod',
          'paymentStatus', 'orderStatus', 'testMode', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'orderNumber', 'userId', 'customerName', 'customerEmail', 'items',
          'subtotal', 'discount', 'total', 'coupon', 'paymentMethod',
          'paymentStatus', 'orderStatus', 'testMode', 'createdAt'
        ])
        && request.resource.data.testMode == true
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.orderNumber.matches('^UAA-[A-F0-9]{12}$')
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() >= 2
        && request.resource.data.customerName.size() <= 60
        && request.resource.data.customerEmail == request.auth.token.email
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.subtotal is number
        && request.resource.data.subtotal >= 0
        && request.resource.data.subtotal <= 1000000
        && request.resource.data.discount is number
        && request.resource.data.discount >= 0
        && request.resource.data.discount <= request.resource.data.subtotal
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.total <= 1000000
        && request.resource.data.coupon in [null, 'UAA20']
        && request.resource.data.paymentMethod == 'cod'
        && request.resource.data.paymentStatus == 'pending'
        && request.resource.data.orderStatus == 'pending'
        && request.resource.data.createdAt == request.time;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update: if admin() && validProduct();
      allow delete: if admin();
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || admin());
      allow list: if admin();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['name', 'email', 'role', 'isActive', 'createdAt'])
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'isActive', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'customer'
        && request.resource.data.isActive == true
        && request.resource.data.createdAt == request.time;
      allow update: if admin()
          && userId != request.auth.uid
          && resource.data.role == 'customer'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isActive'])
          && request.resource.data.role == resource.data.role
          && request.resource.data.isActive is bool
        || signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email'])
          && request.resource.data.role == resource.data.role
          && request.resource.data.isActive == resource.data.isActive
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 60
          && request.resource.data.email == request.auth.token.email;
      allow delete: if false;
    }

    match /orders/{orderId} {
      allow read: if admin();
      allow create: if validTestOrder();
      allow delete: if false;
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'paymentStatus', 'orderStatus', 'updatedAt'
        ])
        && request.resource.data.paymentStatus in ['pending', 'paid', 'failed']
        && request.resource.data.orderStatus in [
          'pending', 'processing', 'shipped', 'completed', 'cancelled'
        ]
        && request.resource.data.updatedAt == request.time;
    }
  }
}
